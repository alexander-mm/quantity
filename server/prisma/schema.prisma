generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   BigInt?
  updatedBy   BigInt?
  users       User[]
}

model Store {
  id                        BigInt              @id @default(autoincrement())
  uuid                      String              @unique @default(uuid())
  code                      String              @unique
  name                      String
  type                      StoreType
  address                   String?
  city                      String?
  phone                     String?
  email                     String?
  manager                   String?
  isActive                  Boolean             @default(true)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  createdBy                 BigInt?
  updatedBy                 BigInt?
  inventoryMovements        InventoryMovement[]
  inventoryStocks           InventoryStock[]
  users                     User[]
  purchases                 Purchase[]
  sales                     Sale[]
  stockTransfersOrigin      StockTransfer[]     @relation("TransferOrigin")
  stockTransfersDestination StockTransfer[]     @relation("TransferDestination")
  returns                   Return[]

  @@index([type])
  @@index([isActive])
}

model User {
  id                         BigInt                @id @default(autoincrement())
  uuid                       String                @unique @default(uuid())
  username                   String                @unique
  password                   String
  firstName                  String
  lastName                   String
  email                      String?
  phone                      String?
  roleId                     BigInt
  storeId                    BigInt
  isActive                   Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  createdBy                  BigInt?
  updatedBy                  BigInt?
  inventoryMovements         InventoryMovement[]
  role                       Role                  @relation(fields: [roleId], references: [id])
  store                      Store                 @relation(fields: [storeId], references: [id])
  purchases                  Purchase[]
  sales                      Sale[]
  stockTransfers             StockTransfer[]
  stockTransfersAsTechnician StockTransfer[]       @relation("TransferDestinationUser")
  partMovements              PartMovement[]
  productAssemblies          ProductAssembly[]
  partAssemblies             PartAssembly[]
  rawMaterialMovements       RawMaterialMovement[]
  partCuttingOrders          PartCuttingOrder[]
  returnsRegistered          Return[]              @relation("ReturnRegisteredBy")
  returnsResolved            Return[]              @relation("ReturnResolvedBy")
  refreshTokens              RefreshToken[]

  @@index([isActive])
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  uuid      String    @unique @default(uuid())
  tokenHash String    @unique
  userId    BigInt
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id               BigInt     @id @default(autoincrement())
  uuid             String     @unique @default(uuid())
  name             String     @unique
  description      String?
  parentCategoryId BigInt?
  stockMultiplier  Decimal    @default(1.5) @db.Decimal(4, 2)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdBy        BigInt?
  updatedBy        BigInt?
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories    Category[] @relation("CategoryHierarchy")
  products         Product[]

  @@index([parentCategoryId])
  @@index([isActive])
}

model Brand {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   BigInt?
  updatedBy   BigInt?
  products    Product[]

  @@index([isActive])
}

model UnitOfMeasure {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  code        String    @unique
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   BigInt?
  updatedBy   BigInt?
  products    Product[]

  @@index([isActive])
}

model Product {
  id                   BigInt                      @id @default(autoincrement())
  uuid                 String                      @unique @default(uuid())
  internalCode         String                      @unique
  barcode              String?                     @unique
  name                 String
  description          String?
  brandId              BigInt
  categoryId           BigInt
  unitOfMeasureId      BigInt
  costPrice            Decimal                     @db.Decimal(12, 2)
  pvp                  Decimal?                    @db.Decimal(12, 2)
  pvpCop               Decimal?                    @db.Decimal(14, 2)
  minimumStock         Decimal                     @db.Decimal(12, 2)
  // Kits: se arman al momento de la venta combinando sus componentes/piezas
  // en vez de llevar stock propio (a diferencia de los Equipos, que se
  // ensamblan por lotes en taller via el modulo de Ensamblaje).
  assembleOnSale       Boolean                     @default(false)
  isActive             Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  createdBy            BigInt?
  updatedBy            BigInt?
  inventoryMovements   InventoryMovement[]
  inventoryStocks      InventoryStock[]
  brand                Brand                       @relation(fields: [brandId], references: [id])
  category             Category                    @relation(fields: [categoryId], references: [id])
  unitOfMeasure        UnitOfMeasure               @relation(fields: [unitOfMeasureId], references: [id])
  productPrices        ProductPrice[]
  priceEntries         ProductPriceEntry[]
  purchaseDetails      PurchaseDetail[]
  saleDetails          SaleDetail[]
  stockTransferDetails StockTransferDetail[]
  components           ProductComponent[]          @relation("ProductComponents")
  usedInComponents     ProductComponent[]          @relation("ComponentOfProducts")
  assemblies           ProductAssembly[]           @relation("ProductAssemblies")
  usedInAssemblies     ProductAssemblyDetail[]     @relation("AssemblyComponentUsage")
  equipmentParts       EquipmentPart[]
  usedInPartComponents PartComponentProduct[]
  usedInPartAssemblies PartAssemblyProductDetail[]
  returns              Return[]

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitOfMeasureId])
  @@index([isActive])
}

model MarginProfile {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  name         String         @unique
  percentage   Decimal        @db.Decimal(5, 2)
  displayOrder Int
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?
  ProductPrice ProductPrice[]

  @@index([displayOrder])
  @@index([isActive])
}

model ProductPrice {
  id              BigInt        @id @default(autoincrement())
  uuid            String        @unique @default(uuid())
  productId       BigInt
  marginProfileId BigInt
  price           Decimal       @db.Decimal(12, 2)
  priceCop        Decimal?      @db.Decimal(14, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  calculatedAt    DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       BigInt?
  updatedBy       BigInt?
  marginProfile   MarginProfile @relation(fields: [marginProfileId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@unique([productId, marginProfileId])
  @@index([marginProfileId])
  @@index([isActive])
}

model Client {
  id                 BigInt              @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  document           String              @unique
  firstName          String?
  lastName           String?
  companyName        String?
  phone              String?
  email              String?
  address            String?
  discountPercentage Decimal?            @db.Decimal(5, 2)
  isWholesaler       Boolean             @default(false)
  usesCredit         Boolean             @default(false)
  currency           Currency?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?
  inventoryMovements InventoryMovement[]
  sales              Sale[]
  accountsReceivable AccountReceivable[]

  @@index([firstName])
  @@index([lastName])
  @@index([companyName])
  @@index([isActive])
  @@index([isWholesaler])
}

model Supplier {
  id           BigInt     @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  code         String     @unique @db.VarChar(20)
  companyName  String     @db.VarChar(150)
  contactName  String?    @db.VarChar(150)
  taxId        String?    @db.VarChar(20)
  phone        String?    @db.VarChar(20)
  email        String?    @db.VarChar(150)
  address      String?    @db.VarChar(250)
  city         String?    @db.VarChar(100)
  observations String?    @db.VarChar(500)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?
  purchases    Purchase[]
}

model Purchase {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  number       String         @unique
  reference    String?
  supplierId   BigInt
  storeId      BigInt
  userId       BigInt
  status       DocumentStatus @default(DRAFT)
  purchaseDate DateTime
  observations String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  details PurchaseDetail[]

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)
}

model PurchaseDetail {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  purchaseId BigInt
  productId  BigInt

  quantity Decimal  @db.Decimal(12, 2)
  unitCost Decimal  @db.Decimal(12, 2)
  pvp      Decimal? @db.Decimal(12, 2)
  pvpCop   Decimal? @db.Decimal(14, 2)

  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?
  updatedBy BigInt?

  purchase     Purchase                   @relation(fields: [purchaseId], references: [id])
  product      Product                    @relation(fields: [productId], references: [id])
  priceEntries PurchaseDetailPriceEntry[]

  @@index([purchaseId])
  @@index([productId])
}

model ProductPriceEntry {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  productId BigInt
  currency  Currency
  sequence  Int
  price     Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@unique([productId, currency, sequence])
  @@index([productId])
}

model PurchaseDetailPriceEntry {
  id               BigInt   @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  purchaseDetailId BigInt
  currency         Currency
  sequence         Int
  price            Decimal  @db.Decimal(14, 2)

  purchaseDetail PurchaseDetail @relation(fields: [purchaseDetailId], references: [id])

  @@unique([purchaseDetailId, currency, sequence])
  @@index([purchaseDetailId])
}

model Sale {
  id            BigInt         @id @default(autoincrement())
  uuid          String         @unique @default(uuid())
  clientUuid    String?        @unique
  number        String         @unique
  reference     String?
  clientId      BigInt
  storeId       BigInt
  userId        BigInt
  status        DocumentStatus @default(DRAFT)
  currency      Currency       @default(USD)
  paymentMethod PaymentMethod  @default(CASH)
  saleDate      DateTime
  observations  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  createdBy     BigInt?
  updatedBy     BigInt?

  client Client @relation(fields: [clientId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  details           SaleDetail[]
  accountReceivable AccountReceivable?
  returns           Return[]
  transferVouchers  SaleTransferVoucher[]

  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  discount     Decimal @default(0) @db.Decimal(12, 2)
  tax          Decimal @default(0) @db.Decimal(12, 2)
  hasShipping  Boolean @default(false)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  hasLabor     Boolean @default(false)
  laborCost    Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @default(0) @db.Decimal(12, 2)
}

enum PaymentMethod {
  CASH
  TRANSFER
  CREDIT
}

// Comprobantes de la transferencia con la que se pagó la venta (Sale.paymentMethod = TRANSFER).
model SaleTransferVoucher {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  saleId    BigInt
  number    String
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model SaleDetail {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  saleId    BigInt
  productId BigInt

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)

  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?
  updatedBy BigInt?

  sale    Sale     @relation(fields: [saleId], references: [id])
  product Product  @relation(fields: [productId], references: [id])
  returns Return[]

  @@index([saleId])
  @@index([productId])
}

enum ReturnReason {
  DAMAGED
  CUSTOMER_CHANGED_MIND
  WRONG_ITEM
  INCOMPATIBLE
  WARRANTY
  OTHER
}

enum ReturnStatus {
  PENDING_REVIEW
  RESOLVED
}

enum ReturnDisposition {
  RESTOCK
  DAMAGED
}

model Return {
  id           BigInt             @id @default(autoincrement())
  uuid         String             @unique @default(uuid())
  clientUuid   String?            @unique
  number       String             @unique
  saleId       BigInt?
  saleDetailId BigInt?
  productId    BigInt
  storeId      BigInt
  quantity     Decimal            @db.Decimal(12, 2)
  reason       ReturnReason
  notes        String?
  status       ReturnStatus       @default(PENDING_REVIEW)
  disposition  ReturnDisposition?
  returnDate   DateTime
  userId       BigInt
  resolvedBy   BigInt?
  resolvedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?

  sale       Sale?       @relation(fields: [saleId], references: [id])
  saleDetail SaleDetail? @relation(fields: [saleDetailId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  store      Store       @relation(fields: [storeId], references: [id])
  user       User        @relation("ReturnRegisteredBy", fields: [userId], references: [id])
  resolver   User?       @relation("ReturnResolvedBy", fields: [resolvedBy], references: [id])

  @@index([status])
  @@index([saleId])
  @@index([productId])
  @@index([storeId])
}

model MovementType {
  id                 BigInt              @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  code               String              @unique
  name               String              @unique
  description        String?
  affectsStock       Boolean             @default(true)
  stockOperation     StockOperation
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?
  inventoryMovements InventoryMovement[]

  @@index([isActive])
  @@index([stockOperation])
}

model InventoryMovement {
  id             BigInt       @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  movementTypeId BigInt
  productId      BigInt
  storeId        BigInt
  userId         BigInt
  clientId       BigInt?
  quantity       Decimal      @db.Decimal(12, 2)
  unitCost       Decimal      @db.Decimal(12, 2)
  observations   String?
  movementDate   DateTime
  syncStatus     SyncStatus   @default(PENDING)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      BigInt?
  updatedBy      BigInt?
  client         Client?      @relation(fields: [clientId], references: [id])
  movementType   MovementType @relation(fields: [movementTypeId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  store          Store        @relation(fields: [storeId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([movementDate])
  @@index([productId])
  @@index([storeId])
  @@index([userId])
  @@index([clientId])
  @@index([movementTypeId])
  @@index([syncStatus])
  @@index([productId, movementDate])
  @@index([storeId, movementDate])
}

model InventoryStock {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  productId BigInt
  storeId   BigInt
  quantity  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?
  updatedBy BigInt?

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
}

model StockTransfer {
  id            BigInt                  @id @default(autoincrement())
  uuid          String                  @unique @default(uuid())
  number        String                  @unique
  originStoreId BigInt
  destType      TransferDestinationType @default(STORE)
  destStoreId   BigInt?
  destUserId    BigInt?
  userId        BigInt
  status        TransferStatus          @default(DRAFT)
  dispatchDate  DateTime
  receivedAt    DateTime?
  receivedBy    BigInt?
  observations  String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     BigInt?
  updatedBy     BigInt?

  originStore Store                 @relation("TransferOrigin", fields: [originStoreId], references: [id])
  destStore   Store?                @relation("TransferDestination", fields: [destStoreId], references: [id])
  destUser    User?                 @relation("TransferDestinationUser", fields: [destUserId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  details     StockTransferDetail[]

  @@index([status])
  @@index([destStoreId])
  @@index([destUserId])
  @@index([originStoreId])
}

model StockTransferDetail {
  id               BigInt   @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  transferId       BigInt
  productId        BigInt
  quantitySent     Decimal  @db.Decimal(12, 2)
  quantityReceived Decimal? @db.Decimal(12, 2)

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

model Settings {
  id             BigInt   @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  companyName    String
  currency       String
  syncInterval   Int      @default(5)
  lowStockAlerts Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      BigInt?
  updatedBy      BigInt?
}

enum StoreType {
  MAIN_WAREHOUSE
  STORE
}

enum StockOperation {
  IN
  OUT
  NONE
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum TransferStatus {
  DRAFT
  PENDING
  RECEIVED
  WITH_ISSUES
  CANCELLED
}

enum TransferDestinationType {
  STORE
  TECHNICIAN
}

enum Currency {
  USD
  COP
}

model PartCategory {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   BigInt?
  updatedBy   BigInt?
  parts       Part[]

  @@index([isActive])
}

model Part {
  id           BigInt   @id @default(autoincrement())
  uuid         String   @unique @default(uuid())
  code         String   @unique
  name         String
  description  String?
  categoryId   BigInt?
  quantity     Decimal  @default(0) @db.Decimal(12, 2)
  minimumStock Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?

  category          PartCategory?                @relation(fields: [categoryId], references: [id])
  movementDetails   PartMovementDetail[]
  recipe            PartRecipe?
  equipmentUsage    EquipmentPart[]
  cuttingOrders     PartCuttingOrder[]
  assemblyUsage     ProductAssemblyPartDetail[]
  components        PartComponent[]             @relation("PartComponents")
  usedInComponents  PartComponent[]             @relation("ComponentOfParts")
  productComponents PartComponentProduct[]
  assemblies        PartAssembly[]              @relation("PartAssemblies")
  usedInAssemblies  PartAssemblyDetail[]        @relation("PartAssemblyComponentUsage")

  @@index([isActive])
  @@index([categoryId])
}

model PartMovement {
  id             BigInt           @id @default(autoincrement())
  uuid           String           @unique @default(uuid())
  number         String           @unique
  type           PartMovementType
  userId         BigInt
  cuttingOrderId BigInt?          @unique
  movementDate   DateTime         @default(now())
  observations   String?
  createdAt      DateTime         @default(now())

  user         User                 @relation(fields: [userId], references: [id])
  cuttingOrder PartCuttingOrder?    @relation(fields: [cuttingOrderId], references: [id])
  details      PartMovementDetail[]

  @@index([type])
  @@index([userId])
}

model PartMovementDetail {
  id         BigInt  @id @default(autoincrement())
  uuid       String  @unique @default(uuid())
  movementId BigInt
  partId     BigInt
  quantity   Decimal @db.Decimal(12, 2)

  movement PartMovement @relation(fields: [movementId], references: [id])
  part     Part         @relation(fields: [partId], references: [id])

  @@index([movementId])
  @@index([partId])
}

enum PartMovementType {
  IN
  OUT
}

model ProductComponent {
  id                 BigInt   @id @default(autoincrement())
  uuid               String   @unique @default(uuid())
  productId          BigInt
  componentProductId BigInt
  quantity           Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product          Product @relation("ProductComponents", fields: [productId], references: [id])
  componentProduct Product @relation("ComponentOfProducts", fields: [componentProductId], references: [id])

  @@unique([productId, componentProductId])
  @@index([productId])
  @@index([componentProductId])
}

model ProductAssembly {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  number       String         @unique
  productId    BigInt
  quantity     Decimal        @db.Decimal(12, 2)
  userId       BigInt
  status       DocumentStatus @default(DRAFT)
  assemblyDate DateTime       @default(now())
  observations String?
  createdAt    DateTime       @default(now())

  product     Product                     @relation("ProductAssemblies", fields: [productId], references: [id])
  user        User                        @relation(fields: [userId], references: [id])
  details     ProductAssemblyDetail[]
  partDetails ProductAssemblyPartDetail[]

  @@index([productId])
  @@index([userId])
}

model ProductAssemblyPartDetail {
  id         BigInt  @id @default(autoincrement())
  uuid       String  @unique @default(uuid())
  assemblyId BigInt
  partId     BigInt
  quantity   Decimal @db.Decimal(12, 2)

  assembly ProductAssembly @relation(fields: [assemblyId], references: [id])
  part     Part            @relation(fields: [partId], references: [id])

  @@index([assemblyId])
  @@index([partId])
}

model AccountReceivable {
  id     BigInt @id @default(autoincrement())
  uuid   String @unique @default(uuid())
  number String @unique

  clientId BigInt
  saleId   BigInt @unique

  // originalAmount: total de la venta. amount: saldo pendiente (originalAmount - downPayment).
  originalAmount    Decimal        @db.Decimal(12, 2)
  amount            Decimal        @db.Decimal(12, 2)
  currency          Currency
  downPayment       Decimal        @default(0) @db.Decimal(12, 2)
  downPaymentMethod PaymentMethod?

  // Plazo de pago en dias (15/30/45/60) y su fecha limite calculada desde la fecha de venta.
  termDays       Int?
  dueDate        DateTime?
  lastReminderAt DateTime?

  isPaid       Boolean   @default(false)
  paidAt       DateTime?
  observations String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  sale   Sale   @relation(fields: [saleId], references: [id])

  downPaymentVouchers AccountReceivableDownPaymentVoucher[]

  @@index([clientId])
  @@index([isPaid])
  @@index([dueDate])
}

// Comprobantes del abono (downPayment), solo si se pago por transferencia.
model AccountReceivableDownPaymentVoucher {
  id                  BigInt   @id @default(autoincrement())
  uuid                String   @unique @default(uuid())
  accountReceivableId BigInt
  number              String
  createdAt           DateTime @default(now())

  accountReceivable AccountReceivable @relation(fields: [accountReceivableId], references: [id])

  @@index([accountReceivableId])
}

model ProductAssemblyDetail {
  id                 BigInt  @id @default(autoincrement())
  uuid               String  @unique @default(uuid())
  assemblyId         BigInt
  componentProductId BigInt
  quantity           Decimal @db.Decimal(12, 2)

  assembly         ProductAssembly @relation(fields: [assemblyId], references: [id])
  componentProduct Product         @relation("AssemblyComponentUsage", fields: [componentProductId], references: [id])

  @@index([assemblyId])
  @@index([componentProductId])
}

enum RawMaterialShape {
  SHEET
  TUBE
  ROD
}

enum TubeProfile {
  ROUND
  SQUARE
  RECTANGULAR
}

enum RawMaterialMovementType {
  IN
  OUT
}

// Materia prima virgen: laminas y tubos de donde se cortan las piezas (Part).
model RawMaterial {
  id           BigInt           @id @default(autoincrement())
  uuid         String           @unique @default(uuid())
  code         String           @unique
  name         String
  shape        RawMaterialShape
  material     String
  thickness    Decimal          @db.Decimal(8, 3)
  // SHEET: width/height = dimensiones de la lamina. TUBE: width = diametro (ROUND) o lado (SQUARE/RECTANGULAR), height = segundo lado (solo RECTANGULAR), length = longitud del tubo. ROD: length = longitud de la varilla, thickness = calibre.
  width        Decimal?         @db.Decimal(10, 2)
  height       Decimal?         @db.Decimal(10, 2)
  length       Decimal?         @db.Decimal(10, 2)
  profile      TubeProfile?
  quantity     Decimal          @default(0) @db.Decimal(12, 2)
  minimumStock Decimal          @default(0) @db.Decimal(12, 2)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?

  recipes         PartRecipe[]
  movementDetails RawMaterialMovementDetail[]
  cuttingOrders   PartCuttingOrder[]

  @@index([isActive])
  @@index([shape])
}

model RawMaterialMovement {
  id             BigInt                  @id @default(autoincrement())
  uuid           String                  @unique @default(uuid())
  number         String                  @unique
  type           RawMaterialMovementType
  userId         BigInt
  cuttingOrderId BigInt?                 @unique
  movementDate   DateTime                @default(now())
  observations   String?
  createdAt      DateTime                @default(now())

  user         User                        @relation(fields: [userId], references: [id])
  cuttingOrder PartCuttingOrder?           @relation(fields: [cuttingOrderId], references: [id])
  details      RawMaterialMovementDetail[]

  @@index([type])
  @@index([userId])
}

model RawMaterialMovementDetail {
  id            BigInt  @id @default(autoincrement())
  uuid          String  @unique @default(uuid())
  movementId    BigInt
  rawMaterialId BigInt
  quantity      Decimal @db.Decimal(12, 2)

  movement    RawMaterialMovement @relation(fields: [movementId], references: [id])
  rawMaterial RawMaterial         @relation(fields: [rawMaterialId], references: [id])

  @@index([movementId])
  @@index([rawMaterialId])
}

// Receta de corte: cuantas unidades de Part salen de UNA unidad de RawMaterial (una lamina o un tubo).
model PartRecipe {
  id            BigInt   @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  partId        BigInt   @unique
  rawMaterialId BigInt
  // lamina: ancho/alto de la pieza. tubo: solo pieceLength (longitud de la pieza cortada).
  pieceWidth    Decimal? @db.Decimal(10, 2)
  pieceHeight   Decimal? @db.Decimal(10, 2)
  pieceLength   Decimal? @db.Decimal(10, 2)
  piecesPerUnit Decimal  @db.Decimal(12, 2)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     BigInt?
  updatedBy     BigInt?

  part        Part        @relation(fields: [partId], references: [id])
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([rawMaterialId])
}

model EquipmentPart {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  productId BigInt
  partId    BigInt
  quantity  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  part    Part    @relation(fields: [partId], references: [id])

  @@unique([productId, partId])
  @@index([productId])
  @@index([partId])
}

model PartComponent {
  id              BigInt   @id @default(autoincrement())
  uuid            String   @unique @default(uuid())
  partId          BigInt
  componentPartId BigInt
  quantity        Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  part          Part @relation("PartComponents", fields: [partId], references: [id])
  componentPart Part @relation("ComponentOfParts", fields: [componentPartId], references: [id])

  @@unique([partId, componentPartId])
  @@index([partId])
  @@index([componentPartId])
}

model PartComponentProduct {
  id                 BigInt   @id @default(autoincrement())
  uuid               String   @unique @default(uuid())
  partId             BigInt
  componentProductId BigInt
  quantity           Decimal  @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  part             Part    @relation(fields: [partId], references: [id])
  componentProduct Product @relation(fields: [componentProductId], references: [id])

  @@unique([partId, componentProductId])
  @@index([partId])
  @@index([componentProductId])
}

model PartAssembly {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  number       String         @unique
  partId       BigInt
  quantity     Decimal        @db.Decimal(12, 2)
  userId       BigInt
  status       DocumentStatus @default(DRAFT)
  assemblyDate DateTime       @default(now())
  observations String?
  createdAt    DateTime       @default(now())

  part           Part                        @relation("PartAssemblies", fields: [partId], references: [id])
  user           User                        @relation(fields: [userId], references: [id])
  details        PartAssemblyDetail[]
  productDetails PartAssemblyProductDetail[]

  @@index([partId])
  @@index([userId])
}

model PartAssemblyDetail {
  id              BigInt  @id @default(autoincrement())
  uuid            String  @unique @default(uuid())
  assemblyId      BigInt
  componentPartId BigInt
  quantity        Decimal @db.Decimal(12, 2)

  assembly      PartAssembly @relation(fields: [assemblyId], references: [id])
  componentPart Part         @relation("PartAssemblyComponentUsage", fields: [componentPartId], references: [id])

  @@index([assemblyId])
  @@index([componentPartId])
}

model PartAssemblyProductDetail {
  id                 BigInt  @id @default(autoincrement())
  uuid               String  @unique @default(uuid())
  assemblyId         BigInt
  componentProductId BigInt
  quantity           Decimal @db.Decimal(12, 2)

  assembly         PartAssembly @relation(fields: [assemblyId], references: [id])
  componentProduct Product      @relation(fields: [componentProductId], references: [id])

  @@index([assemblyId])
  @@index([componentProductId])
}

model PartCuttingOrder {
  id                 BigInt         @id @default(autoincrement())
  uuid               String         @unique @default(uuid())
  number             String         @unique
  partId             BigInt
  rawMaterialId      BigInt
  rawMaterialQtyUsed Decimal        @db.Decimal(12, 2)
  expectedPieces     Decimal        @db.Decimal(12, 2)
  goodPieces         Decimal        @default(0) @db.Decimal(12, 2)
  defectivePieces    Decimal        @default(0) @db.Decimal(12, 2)
  status             DocumentStatus @default(DRAFT)
  userId             BigInt
  cuttingDate        DateTime       @default(now())
  observations       String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?

  part                Part                 @relation(fields: [partId], references: [id])
  rawMaterial         RawMaterial          @relation(fields: [rawMaterialId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  partMovement        PartMovement?
  rawMaterialMovement RawMaterialMovement?

  @@index([partId])
  @@index([rawMaterialId])
  @@index([userId])
  @@index([status])
}
