generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Role {
  id          BigInt   @id @default(autoincrement())
  uuid        String   @unique @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   BigInt?
  updatedBy   BigInt?
  users       User[]
}

model Store {
  id                 BigInt              @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  code               String              @unique
  name               String
  type               StoreType
  address            String?
  city               String?
  phone              String?
  email              String?
  manager            String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?
  inventoryMovements InventoryMovement[]
  inventoryStocks    InventoryStock[]
  users              User[]
  purchases          Purchase[]
  sales              Sale[]
  stockTransfersOrigin      StockTransfer[] @relation("TransferOrigin")
  stockTransfersDestination StockTransfer[] @relation("TransferDestination")

  @@index([type])
  @@index([isActive])
}

model User {
  id                 BigInt              @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  username           String              @unique
  password           String
  firstName          String
  lastName           String
  email              String?
  phone              String?
  roleId             BigInt
  storeId            BigInt
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?
  inventoryMovements InventoryMovement[]
  role               Role                @relation(fields: [roleId], references: [id])
  store              Store               @relation(fields: [storeId], references: [id])
  purchases          Purchase[]
  sales              Sale[]
  stockTransfers StockTransfer[]
   stockTransfersAsTechnician StockTransfer[] @relation("TransferDestinationUser")

  @@index([isActive])
}

model Category {
  id               BigInt     @id @default(autoincrement())
  uuid             String     @unique @default(uuid())
  name             String     @unique
  description      String?
  parentCategoryId BigInt?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  createdBy        BigInt?
  updatedBy        BigInt?
  parentCategory   Category?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  subcategories    Category[] @relation("CategoryHierarchy")
  products         Product[]

  @@index([parentCategoryId])
  @@index([isActive])
}

model Brand {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   BigInt?
  updatedBy   BigInt?
  products    Product[]

  @@index([isActive])
}

model UnitOfMeasure {
  id          BigInt    @id @default(autoincrement())
  uuid        String    @unique @default(uuid())
  code        String    @unique
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   BigInt?
  updatedBy   BigInt?
  products    Product[]

  @@index([isActive])
}

model Product {
  id                 BigInt              @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  internalCode       String              @unique
  barcode            String?             @unique
  name               String
  description        String?
  brandId            BigInt
  categoryId         BigInt
  unitOfMeasureId    BigInt
  costPrice          Decimal             @db.Decimal(12, 2)
  pvp                Decimal?            @db.Decimal(12, 2)
  pvpCop             Decimal?            @db.Decimal(14, 2)
  minimumStock       Decimal             @db.Decimal(12, 2)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?
  inventoryMovements InventoryMovement[]
  inventoryStocks    InventoryStock[]
  brand              Brand               @relation(fields: [brandId], references: [id])
  category           Category            @relation(fields: [categoryId], references: [id])
  unitOfMeasure      UnitOfMeasure       @relation(fields: [unitOfMeasureId], references: [id])
  productPrices      ProductPrice[]
  purchaseDetails    PurchaseDetail[]
  saleDetails        SaleDetail[]
  stockTransferDetails StockTransferDetail[]

  @@index([name])
  @@index([categoryId])
  @@index([brandId])
  @@index([unitOfMeasureId])
  @@index([isActive])
}

model MarginProfile {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  name         String         @unique
  percentage   Decimal        @db.Decimal(5, 2)
  displayOrder Int
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?
  ProductPrice ProductPrice[]

  @@index([displayOrder])
  @@index([isActive])
}

model ProductPrice {
  id              BigInt        @id @default(autoincrement())
  uuid            String        @unique @default(uuid())
  productId       BigInt
  marginProfileId BigInt
  price           Decimal       @db.Decimal(12, 2)
  priceCop        Decimal?      @db.Decimal(14, 2)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  calculatedAt    DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  createdBy       BigInt?
  updatedBy       BigInt?
  marginProfile   MarginProfile @relation(fields: [marginProfileId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@unique([productId, marginProfileId])
  @@index([marginProfileId])
  @@index([isActive])
}

model Client {
  id                 BigInt              @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  document           String              @unique
  firstName          String?
  lastName           String?
  companyName        String?
  phone              String?
  email              String?
  address            String?
  discountPercentage Decimal?            @db.Decimal(5, 2)
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?
  inventoryMovements InventoryMovement[]
  sales               Sale[]

  @@index([firstName])
  @@index([lastName])
  @@index([companyName])
  @@index([isActive])
}

model Supplier {
  id           BigInt     @id @default(autoincrement())
  uuid         String     @unique @default(uuid())
  code         String     @unique @db.VarChar(20)
  companyName  String     @db.VarChar(150)
  contactName  String?    @db.VarChar(150)
  taxId        String?    @db.VarChar(20)
  phone        String?    @db.VarChar(20)
  email        String?    @db.VarChar(150)
  address      String?    @db.VarChar(250)
  city         String?    @db.VarChar(100)
  observations String?    @db.VarChar(500)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?
  purchases    Purchase[]
}

model Purchase {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  number       String         @unique
  reference String?
  supplierId   BigInt
  storeId      BigInt
  userId       BigInt
  status       DocumentStatus @default(DRAFT)
  purchaseDate DateTime
  observations String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?

  supplier Supplier @relation(fields: [supplierId], references: [id])
  store    Store    @relation(fields: [storeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  details PurchaseDetail[]

  subtotal Decimal @default(0) @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  tax      Decimal @default(0) @db.Decimal(12,2)
  total    Decimal @default(0) @db.Decimal(12,2)
}

model PurchaseDetail {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  purchaseId BigInt
  productId  BigInt

  quantity Decimal @db.Decimal(12, 2)
  unitCost Decimal @db.Decimal(12, 2)
  pvp      Decimal? @db.Decimal(12, 2)

  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?
  updatedBy BigInt?

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id           BigInt         @id @default(autoincrement())
  uuid         String         @unique @default(uuid())
  number       String         @unique
  reference    String?
  clientId     BigInt
  storeId      BigInt
  userId       BigInt
  status       DocumentStatus @default(DRAFT)
  currency     Currency       @default(USD)
  saleDate     DateTime
  observations String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdBy    BigInt?
  updatedBy    BigInt?

  client Client @relation(fields: [clientId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  details SaleDetail[]

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)
}

model SaleDetail {
  id   BigInt @id @default(autoincrement())
  uuid String @unique @default(uuid())

  saleId    BigInt
  productId BigInt

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)

  discount  Decimal @default(0) @db.Decimal(12, 2)
  tax       Decimal @default(0) @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?
  updatedBy BigInt?

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model MovementType {
  id                 BigInt              @id @default(autoincrement())
  uuid               String              @unique @default(uuid())
  code               String              @unique
  name               String              @unique
  description        String?
  affectsStock       Boolean             @default(true)
  stockOperation     StockOperation
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          BigInt?
  updatedBy          BigInt?
  inventoryMovements InventoryMovement[]

  @@index([isActive])
  @@index([stockOperation])
}

model InventoryMovement {
  id             BigInt       @id @default(autoincrement())
  uuid           String       @unique @default(uuid())
  movementTypeId BigInt
  productId      BigInt
  storeId        BigInt
  userId         BigInt
  clientId       BigInt?
  quantity       Decimal      @db.Decimal(12, 2)
  unitCost       Decimal      @db.Decimal(12, 2)
  observations   String?
  movementDate   DateTime
  syncStatus     SyncStatus   @default(PENDING)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      BigInt?
  updatedBy      BigInt?
  client         Client?      @relation(fields: [clientId], references: [id])
  movementType   MovementType @relation(fields: [movementTypeId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  store          Store        @relation(fields: [storeId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([movementDate])
  @@index([productId])
  @@index([storeId])
  @@index([userId])
  @@index([clientId])
  @@index([movementTypeId])
  @@index([syncStatus])
  @@index([productId, movementDate])
  @@index([storeId, movementDate])
}

model InventoryStock {
  id        BigInt   @id @default(autoincrement())
  uuid      String   @unique @default(uuid())
  productId BigInt
  storeId   BigInt
  quantity  Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy BigInt?
  updatedBy BigInt?

  product Product @relation(fields: [productId], references: [id])
  store   Store   @relation(fields: [storeId], references: [id])

  @@unique([productId, storeId])
  @@index([productId])
  @@index([storeId])
}

model StockTransfer {
  id            BigInt                  @id @default(autoincrement())
  uuid          String                  @unique @default(uuid())
  number        String                  @unique
  originStoreId BigInt
  destType      TransferDestinationType @default(STORE)
  destStoreId   BigInt?
  destUserId    BigInt?
  userId        BigInt
  status        TransferStatus          @default(PENDING)
  dispatchDate  DateTime
  receivedAt    DateTime?
  receivedBy    BigInt?
  observations  String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  createdBy     BigInt?
  updatedBy     BigInt?

  originStore Store                 @relation("TransferOrigin", fields: [originStoreId], references: [id])
  destStore   Store?                @relation("TransferDestination", fields: [destStoreId], references: [id])
  destUser    User?                 @relation("TransferDestinationUser", fields: [destUserId], references: [id])
  user        User                  @relation(fields: [userId], references: [id])
  details     StockTransferDetail[]

  @@index([status])
  @@index([destStoreId])
  @@index([destUserId])
  @@index([originStoreId])
}

model StockTransferDetail {
  id               BigInt   @id @default(autoincrement())
  uuid             String   @unique @default(uuid())
  transferId       BigInt
  productId        BigInt
  quantitySent     Decimal  @db.Decimal(12, 2)
  quantityReceived Decimal? @db.Decimal(12, 2)

  transfer StockTransfer @relation(fields: [transferId], references: [id])
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
}

model Settings {
  id             BigInt   @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  companyName    String
  currency       String
  syncInterval   Int      @default(5)
  lowStockAlerts Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      BigInt?
  updatedBy      BigInt?
}

enum StoreType {
  MAIN_WAREHOUSE
  STORE
}

enum StockOperation {
  IN
  OUT
  NONE
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
}

enum DocumentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum TransferStatus {
  PENDING
  RECEIVED
  WITH_ISSUES
  CANCELLED
}

enum TransferDestinationType {
  STORE
  TECHNICIAN
}

enum Currency {
  USD
  COP
}