{
  "name": "server",
  "version": "1.0.0",
  "description": "ORDEPLUS Quantity ERP Backend",
  "private": true,
  "type": "module",
  "main": "dist/src/bootstrap/server.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "check": "tsc --noEmit && prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:format": "prisma format",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "products:import": "tsx scripts/import-products.ts",
    "products:wipe": "tsx scripts/wipe-product-catalog.ts",
    "prisma:deploy:prod": "dotenv -e .env.production -- prisma migrate deploy",
    "prisma:deploy:branch": "dotenv -e .env.branch -- prisma migrate deploy",
    "products:import:branch": "dotenv -e .env.branch -- tsx scripts/import-products.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.22.0",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.0",
    "@types/pdfmake": "^0.3.3",
    "dotenv-cli": "^11.0.0",
    "neonctl": "^2.46.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.16.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
